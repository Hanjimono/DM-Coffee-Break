generator client {
  provider = "prisma-client"
  output   = "./generated/prisma"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model mediaCategory {
  id        Int      @id @default(autoincrement())
  title     String
  hex       String?
  createdAt DateTime             @default(now())
  updatedAt DateTime             @default(now())
}

model settings {
  id        Int                    @id @default(autoincrement())
  key       String
  value     String?
  category  Int?                   @default(0)
  createdAt DateTime               @default(now())
  updatedAt DateTime               @default(now())
}

model song {
  id         Int      @id @default(autoincrement())
  title      String
  artist     String?
  duration   Int?
  thumbnail  String?
  url        String
  comment    String?
  source     Int
  categoryId Int?
  createdAt  DateTime               @default(now())
  updatedAt  DateTime               @default(now())
  tags       tag[]
}

model tag {
  id        Int      @id @default(autoincrement())
  title     String
  color     String?
  createdAt DateTime               @default(now())
  updatedAt DateTime               @default(now())
  songs     song[]
}